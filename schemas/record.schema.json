{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jackylawck.github.io/veil/schemas/record.schema.json",
  "title": "The Veil - Sovereign UAP Intelligence Record Schema v2.0.0",
  "type": "object",
  "required": ["metadata", "records"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": ["title", "zh_title", "generated_at", "total_records"],
      "properties": {
        "title": { "type": "string" },
        "zh_title": { "type": "string" },
        "generated_at": { "type": "string" },
        "duration_sec": { "type": "number" },
        "total_records": { "type": "integer", "minimum": 0 },
        "curated_historical_records": { "type": "integer" },
        "live_adapters_active": { "type": "integer" },
        "api_metrics": { "type": "object" }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Record"
      }
    }
  },
  "$defs": {
    "Record": {
      "type": "object",
      "required": ["id", "type", "date", "governance", "entities", "content", "sources"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[A-Za-z0-9-_]+$"
        },
        "type": {
          "type": "string",
          "enum": ["hearing", "bill", "report", "statement", "foia", "media", "official_report"]
        },
        "date": {
          "type": "object",
          "required": ["val", "precision"],
          "properties": {
            "val": { "type": "string" },
            "precision": {
              "type": "string",
              "enum": ["day", "month", "year"]
            }
          }
        },
        "governance": {
          "type": "object",
          "required": ["source_tier", "evidence_level", "confidence_rating"],
          "properties": {
            "source_tier": {
              "type": "string",
              "enum": ["Tier-1", "Tier-2", "Tier-3"]
            },
            "evidence_level": {
              "type": "string",
              "enum": ["official_document", "testimony_sworn", "unsworn_claim", "circumstantial"]
            },
            "confidence_rating": {
              "type": "string",
              "enum": ["official_confirmed", "substantiated", "unconfirmed"]
            }
          }
        },
        "entities": {
          "type": "object",
          "required": ["agencies"],
          "properties": {
            "agencies": {
              "type": "array",
              "items": { "type": "string" }
            },
            "people": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "content": {
          "type": "object",
          "required": ["en", "zh_hk"],
          "properties": {
            "original_language": { "type": "string" },
            "en": {
              "type": "object",
              "required": ["title", "executive_summary"],
              "properties": {
                "title": { "type": "string" },
                "executive_summary": { "type": "string" }
              }
            },
            "zh_hk": {
              "type": "object",
              "required": ["title", "executive_summary"],
              "properties": {
                "title": { "type": "string" },
                "executive_summary": { "type": "string" }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string" },
              "sha256": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
