{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jackylawck.github.io/veil/schemas/record.schema.json",
  "title": "The Veil - Intelligence Record Schema v2.0",
  "type": "object",
  "required": ["version", "records"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "enum": ["2.0.0"]
    },
    "metadata": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Record"
      }
    }
  },
  "$defs": {
    "Record": {
      "type": "object",
      "required": ["id", "type", "evidence_level", "date", "title", "agency", "summary", "sources"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[A-Za-z0-9-_]+$"
        },
        "type": {
          "type": "string",
          "enum": ["hearing", "bill", "report", "statement", "foia", "media"]
        },
        "evidence_level": {
          "type": "string",
          "enum": ["official_document", "testimony_sworn", "unsworn_claim", "circumstantial"]
        },
        "date": {
          "type": "object",
          "required": ["val", "precision"],
          "properties": {
            "val": {
              "type": "string"
            },
            "precision": {
              "type": "string",
              "enum": ["day", "month", "year"]
            }
          }
        },
        "title": {
          "type": "object",
          "required": ["en", "zh_hk"],
          "properties": {
            "en": { "type": "string" },
            "zh_hk": { "type": "string" }
          }
        },
        "agency": {
          "type": "object",
          "required": ["id", "name", "zh_hk", "jurisdiction"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "zh_hk": { "type": "string" },
            "jurisdiction": { "type": "string" }
          }
        },
        "summary": {
          "type": "object",
          "required": ["en", "zh_hk"],
          "properties": {
            "en": { "type": "string" },
            "zh_hk": { "type": "string" }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "url", "source_name"],
            "properties": {
              "type": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "sha256": {
                "type": ["string", "null"]
              },
              "sha256_verified": { "type": "boolean" },
              "source_name": { "type": "string" },
              "byte_size": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
